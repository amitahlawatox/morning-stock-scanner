# ── Stock Scanner API Keys ──────────────────────────────────
# Finnhub (free tier): https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# Polygon.io (free tier – 5 calls/min): https://polygon.io/dashboard/signup
POLYGON_API_KEY=your_polygon_api_key_here

# ── WhatsApp Notification (Twilio) ──────────────────────────
# Sign up: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Default Twilio WhatsApp sandbox number (change if you have an approved number)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your WhatsApp number in international format
WHATSAPP_TO=+44xxxxxxxxxx
